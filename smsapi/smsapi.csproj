<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ProductVersion>8.0.30703</ProductVersion>
        <SchemaVersion>2.0</SchemaVersion>
        <Deterministic>false</Deterministic>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <LangVersion>10</LangVersion>
        <Title>SMSAPI</Title>
        <Authors>SMSAPI</Authors>
        <Copyright>SMSAPI</Copyright>
        <RepositoryUrl>https://github.com/smsapi/smsapi-csharp-client</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Company>SMSAPI</Company>
        <Product>SMSAPI</Product>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIconUrl>logo.jpg</PackageIconUrl>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>SMSAPI.pl</PackageId>
        <PackageVersion>3.0.0</PackageVersion>
        <PackagerequireLicenseAcceptance>false</PackagerequireLicenseAcceptance>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://www.smsapi.com</PackageProjectUrl>
        <PackageDescription>SMSAPI Client that allows to send SMS, MMS, VMS and manage your SMSAPI account.</PackageDescription>
        <PackageReleaseNotes>3.0.0: OAuth-only authentication, RestSharp replaced with HttpClient, async support, new features (MFA, HLR, Blacklist, Opt-out, Short URLs, Subusers, Sender names, Profile, Prices, Ping), .NET 6-10. See CHANGELOG.md for breaking changes.</PackageReleaseNotes>
        <PackageTags>smsapi;sms;marketing;shipment;mms;vms;message</PackageTags>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <Folder Include="Api\Action\Contacts\" />
        <Folder Include="docs\icons" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <None Include="docs\LICENSE.md" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
        <None Include="docs\icons\logo.jpg" Pack="true" PackagePath="" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
